# Variables de entorno para desarrollo local (Petly)

SECRET_KEY=django-insecure-development-key-petly-2026
DEBUG=True

# Dominios y hosts permitidos
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Identificación del dominio propio (utilizado para enlaces absolutos en correos)
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http

# Base de datos SQLite
DATABASE_DIR=data
DATABASE_NAME=db.sqlite3
